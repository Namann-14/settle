CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
DATABASE_URL=

# Telegram bot (create it with @BotFather, which gives the token)
TELEGRAM_BOT_TOKEN=
# bot username without @, used for the t.me/<bot>?start=<code> link
TELEGRAM_BOT_USERNAME=
# any random string; registered with setWebhook, Telegram echoes it on every update
TELEGRAM_WEBHOOK_SECRET=
BOT_TIMEZONE=Asia/Kolkata

# services/ai for server-to-server extraction; INTERNAL_API_KEY must match ai's.
# On Vercel: BOT_AI_SERVICE_URL=https://<your-domain>/ai, AI_ROUTE_PREFIX left as is (no service
# binding: ai already binds to api and Vercel rejects circular bindings; BOT_ prefix
# because project env vars would otherwise clash with web's AI_SERVICE_URL binding).
AI_SERVICE_URL=http://localhost:8001
AI_ROUTE_PREFIX=
INTERNAL_API_KEY=
