CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
DATABASE_URL=

# WhatsApp Cloud API bot (developers.facebook.com → your app → WhatsApp)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# bot's number, digits only, shown to users for linking (e.g. 15551234567)
WHATSAPP_BOT_NUMBER=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_TIMEZONE=Asia/Kolkata

# services/ai for server-to-server extraction; INTERNAL_API_KEY must match ai's.
# On Vercel: AI_SERVICE_URL=https://<your-domain> and AI_ROUTE_PREFIX=/ai (no service
# binding: ai already binds to api and Vercel rejects circular bindings).
AI_SERVICE_URL=http://localhost:8001
AI_ROUTE_PREFIX=
INTERNAL_API_KEY=
