GROQ_API_KEY=

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=settle-ai

API_SERVICE_URL=http://localhost:8000

# Optional overrides — defaults in app/core/config.py are fine for local dev
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_EXTRACTION_MODEL=openai/gpt-oss-120b
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Receipt OCR — VISION_PROVIDER=none (default) returns a clear 501.
# Set to "ocrspace" to use OCR.Space's free-tier API (ocr.space/ocrapi).
# VISION_PROVIDER=ocrspace
# OCR_SPACE_API_KEY=
# OCR_SPACE_LANGUAGE=eng
