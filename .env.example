# Database Configuration
# Replace with your actual PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/settle"
DIRECT_URL="postgresql://username:password@localhost:5432/settle"

# NextAuth.js Configuration
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here-replace-with-actual-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (Optional - for Google Sign-in)
# Get these from: https://console.developers.google.com/
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email Configuration
# Choose your email provider and configure accordingly

# Option 1: Gmail (Recommended for development)
EMAIL_PROVIDER="gmail"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-16-character-app-password"
EMAIL_FROM="Settle <your-email@gmail.com>"

# Option 2: Generic SMTP (for other providers)
# EMAIL_PROVIDER="smtp"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# EMAIL_USER="your-email@example.com"
# EMAIL_PASSWORD="your-password"
# EMAIL_FROM="Settle <noreply@yourdomain.com>"

# AI & OCR Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# Development Environment
NODE_ENV="development"

# Optional: Vercel URL (automatically set on Vercel)
# VERCEL_URL="your-app.vercel.app"
