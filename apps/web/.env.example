NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

BACKEND_URL=http://localhost:8000

# Public origin for canonical URLs, sitemap and robots. Set to the production
# domain on Vercel; falls back to VERCEL_PROJECT_PRODUCTION_URL, then localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# AI service (services/ai). On Vercel AI_SERVICE_URL comes from the service
# binding; set AI_ROUTE_PREFIX=/ai there to match the ai service.
AI_SERVICE_URL=http://localhost:8001
AI_ROUTE_PREFIX=
